{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "schedule": [
    "before 4am on monday"
  ],
  "dockerfile": {
    "enabled": true
  },
  "helm-values": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile",
        "helm-values"
      ],
      "matchPackageNames": [
        "jonashonecker/feedpaper"
      ],
      "versioning": "docker",
      "description": "Track feedpaper releases and update the pinned image tag automatically when a new release is published."
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "python"
      ],
      "versioning": "docker",
      "description": "Track updates for the Python base image used in the container build without pinning to a floating tag."
    }
  ]
}
