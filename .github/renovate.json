{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "schedule": [
    "before 4am on monday"
  ],
  "dockerfile": {
    "enabled": true
  },
  "helm-values": {
    "enabled": true,
    "fileMatch": [
      "(^|/)values.*\\.ya?ml$"
    ]
  },
  "git-submodules": {
    "enabled": true
  },
  "helmfile": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "python"
      ],
      "versioning": "docker",
      "description": "Track updates for the Python base image used in the container build without pinning to a floating tag."
    },
    {
      "matchManagers": [
        "helm-values"
      ],
      "matchPackageNames": [
        "rarosalion/feedpaper-docker"
      ],
      "versioning": "docker",
      "description": "Bump the pinned feedpaper-docker image tag in the Helm values files whenever release.yml/docker-publish.yml cut a new version."
    }
  ]
}
