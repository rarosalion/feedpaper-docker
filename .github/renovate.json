{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "schedule": [
    "before 4am on monday"
  ],
  "dockerfile": {
    "enabled": true
  },
  "helm-values": {
    "enabled": true
  },
  "git-submodules": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "python"
      ],
      "versioning": "docker",
      "description": "Track updates for the Python base image used in the container build without pinning to a floating tag."
    }
  ]
}
